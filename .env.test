# Committed on purpose. These credentials address a throwaway container on a non-default
# port (docker-compose.test.yml), so `pnpm test:integration` works on a clean clone with no
# setup ritual. The real `.env` — Neon URL, real AUTH_SECRET — stays gitignored.

TEST_DATABASE_URL="postgresql://test:test@localhost:55432/shared_docs_test?schema=public"

# Prisma validates EVERY env var the schema references at CLI startup, and schema.prisma
# declares directUrl. Without this, `prisma db push` in the integration global-setup dies
# with "Environment variable not found: DIRECT_URL" before a single assertion runs.
DIRECT_URL="postgresql://test:test@localhost:55432/shared_docs_test?schema=public"

# The session-signing key is AUTH_SECRET and nothing else, and it must be >= 32 characters.
# lib/env.ts throws below that at module evaluation, which would fail every integration test
# with an env error before a single assertion runs.
AUTH_SECRET="test-secret-not-for-production-00000000"
