# Neon production credentials — deliberately NOT named .env*.local:
# `next start` runs in production mode and Next auto-loads .env.production.local
# ahead of .env, which silently points a "local" server at production. See D013.
ops/neon.env

# Recording artifacts (large binaries, regenerated by video/record.mjs)
video-out/
screenshots/probe-*.png

# Submission staging — regenerated by git archive; the .md files are copies of the root ones
submission/
