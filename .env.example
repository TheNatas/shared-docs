# Copy to .env and fill in. `openssl rand -base64 32` generates AUTH_SECRET.
#
# LOCAL: both URLs point at the container from docker-compose.test.yml.
#   DATABASE_URL="postgresql://test:test@localhost:55432/shared_docs_dev"
#   DIRECT_URL="postgresql://test:test@localhost:55432/shared_docs_dev"
#
# PRODUCTION (Neon): these MUST differ.
#   DATABASE_URL  the POOLED endpoint — host contains "-pooler". Used at runtime.
#                 Append ?sslmode=require&pgbouncer=true&connection_limit=1
#   DIRECT_URL    the DIRECT endpoint. Used only by `prisma migrate`.
#   Swapping them "works" until a reviewer's concurrency produces "too many connections".

DATABASE_URL=""
DIRECT_URL=""
AUTH_SECRET=""
